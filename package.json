{
  "name": "chaoticreview",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run typecheck && vite build",
    "build:mac": "node scripts/build-macos.mjs",
    "build:mac:arm64": "node scripts/build-macos.mjs arm64",
    "build:mac:intel": "node scripts/build-macos.mjs intel",
    "test": "node --import tsx scripts/fileStore.test.ts && node --import tsx scripts/diff.test.ts && node --import tsx scripts/playbooks.test.ts && node --import tsx scripts/agents.test.ts && node --import tsx scripts/chatDefaults.test.ts && node --import tsx scripts/chatTimeline.test.ts && node --import tsx scripts/chatQueue.test.ts && node --import tsx scripts/tasks.test.ts && node --import tsx scripts/taskColumns.test.ts && node --import tsx scripts/taskSchedule.test.ts && node --import tsx scripts/taskSandbox.test.ts && node --import tsx scripts/promptSchedules.test.ts && node --import tsx scripts/laneAutomation.test.ts && node --import tsx scripts/taskControl.test.ts && node --import tsx scripts/github.test.ts && node --import tsx scripts/pomodoro.test.ts && node --import tsx scripts/mockTauri.test.ts && node scripts/drawingFonts.test.mjs && node scripts/pngEncoding.test.mjs",
    "test:mcp-oauth": "python3 scripts/mcpOAuth.test.py",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src --max-warnings 0",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:browser:native": "node scripts/native-browser-tests.mjs",
    "test:production": "node scripts/production-tests.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@dnd-kit/react": "^0.5.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.3",
    "@mdxeditor/editor": "^4.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "png-chunks-encode": "file:./vendor/png-chunks-encode"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.4"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "@radix-ui/react-popover": "^1.1.23",
      "@radix-ui/react-tabs": "^1.1.21",
      "@excalidraw/mermaid-to-excalidraw": "^3.6.0"
    },
    "nanoid@^3": "^3.3.18",
    "nanoid@^4": "^5.1.16",
    "minimatch": "^11.0.1",
    "png-chunks-encode": "$png-chunks-encode"
  }
}
